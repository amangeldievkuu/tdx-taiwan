{
  "name": "tdx-taiwan",
  "version": "0.13.0",
  "description": "Unofficial TypeScript SDK for Taiwan's TDX (Transport Data eXchange) API — YouBike, bus routes and ETA, metro, high speed rail and Taiwan Railway timetables, fares and live boards, parking availability, EV charging, live airport flight boards, live road traffic and ferry timetables, fares and live boards",
  "keywords": [
    "tdx",
    "taiwan",
    "transport",
    "youbike",
    "bus",
    "metro",
    "thsr",
    "high-speed-rail",
    "tra",
    "railway",
    "parking",
    "ev-charging",
    "flights",
    "airport",
    "fids",
    "traffic",
    "road",
    "congestion",
    "cctv",
    "ferry",
    "ship",
    "blue-highway",
    "mrt",
    "odata",
    "ptx",
    "nestjs"
  ],
  "license": "MIT",
  "author": "Kutman",
  "homepage": "https://github.com/amangeldievkuu/tdx-taiwan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amangeldievkuu/tdx-taiwan.git"
  },
  "bugs": {
    "url": "https://github.com/amangeldievkuu/tdx-taiwan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:exports": "publint && attw --pack . --profile node16",
    "example:youbike": "tsx examples/nearest-youbike.ts",
    "example:metro": "tsx examples/next-metro-train.ts",
    "example:thsr": "tsx examples/thsr-trains.ts",
    "example:tra": "tsx examples/tra-trains.ts",
    "example:parking": "tsx examples/nearest-parking.ts",
    "example:ev": "tsx examples/nearest-ev-charger.ts",
    "example:flights": "tsx examples/flight-board.ts",
    "example:traffic": "tsx examples/road-traffic.ts",
    "example:ferry": "tsx examples/ferry-departures.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
